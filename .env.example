# --- PostgreSQL ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/webclip_monitor
# Set true for managed Postgres over an external URL (e.g. Render external).
# Internal same-provider URLs don't need it. (sslmode=require in the URL also enables it.)
DATABASE_SSL=false
# DANGER — one-shot recovery only. true drops & recreates the whole public schema
# on startup (wipes all data), to recover a database left in a broken state.
# Enable for a single deploy, then REMOVE it. Leave unset in normal operation.
# DB_RESET=false

# --- HTTP server ---
PORT=3000
HOST=0.0.0.0

# --- Crawler ---
# Max concurrent page fetches per task
CRAWL_CONCURRENCY=4
# Per-page navigation timeout (ms)
NAV_TIMEOUT_MS=30000
# Global hard cap on nodes per task (safety net against runaway trees)
MAX_NODES_PER_TASK=2000
# Device profile to emulate (must exist in Playwright's device registry)
DEVICE_PROFILE=iPhone 13

# --- Domain expiry ---
# Re-check a domain at most once per this many hours
DOMAIN_RECHECK_HOURS=24
# Warn when a domain expires within this many days (in addition to already-expired)
EXPIRY_WARN_DAYS=14

# --- Scheduler ---
# Enable the cron scheduler for recurring rescans
ENABLE_SCHEDULER=true

# --- Telegram ---
# Configured ONLY in the web admin (Settings page), not via env vars.

# Optional: pre-provisioned Chromium (leave unset to let Playwright manage its own)
CHROMIUM_EXECUTABLE_PATH=
