{
  "name": "webclip-monitor",
  "version": "0.1.0",
  "description": "Recursively crawl landing/nav pages, decode obfuscated payloads, extract iOS webclips, resolve domains and alert on expiry via Telegram.",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "migrate": "node src/db/migrate.js",
    "worker": "node src/scan/worker.js",
    "dev": "node --watch src/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "node-cron": "^3.0.3",
    "node-forge": "^1.3.1",
    "pg": "^8.13.1",
    "playwright": "^1.56.1",
    "plist": "^3.1.0",
    "tldts": "^6.1.71",
    "undici": "^6.29.1",
    "whois": "^2.14.5"
  }
}
